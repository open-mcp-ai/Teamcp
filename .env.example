# 复制成 .env 后填写。docker compose 会自动读取。
#
# 域名（Caddy 用它申请证书）
TEAMCP_DOMAIN=teamcp.example.com

# 共享密钥：必须设置，否则任何能连到端口的人都能自称任何 principal。
#   openssl rand -base64 32
TEAMCP_PROXY_SECRET=

# 登录凭据：一个 htpasswd 条目 = 一个 principal。
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
TEAMCP_BASIC_USER=team
TEAMCP_BASIC_HASH=

# 允许使用 /admin 的 principal（逗号分隔）。留空则沿用令牌/本机规则——
# 在多用户部署里这意味着**没有人**能改身份，直到你在这里点名。
TEAMCP_ADMIN_PRINCIPALS=

# 每个参与方每分钟最多发多少条；0 = 不限
TEAMCP_RATE_MSG_PER_MIN=60

VERSION=dev
